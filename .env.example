# ---- 認証 (NextAuth v5 + Google OAuth) ----
# Google Cloud Console > 認証情報 > OAuth 2.0 クライアント ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# セッションCookieの署名鍵。`npx auth secret` で生成
AUTH_SECRET=
# 独自ドメインに移したら本番URLを設定する（未設定だと Vercel が推測したURLへリダイレクトする）
# AUTH_URL=https://classmino.com

# ---- データベース (Supabase + Prisma) ----
# アプリ用。必ず**プーラー(pgbouncer / ポート6543)**を指すこと。
# 直結(5432)だとサーバーレスの関数ごとに接続が張られて枯渇する。
DATABASE_URL=postgresql://...@...pooler.supabase.com:6543/postgres?pgbouncer=true
# マイグレーション/`prisma db push` 用の直結(5432)。プーラー経由ではDDLが流せない。
DIRECT_URL=postgresql://...@...supabase.com:5432/postgres

# ---- メール通知 (Resend) ----
RESEND_API_KEY=
# 独自ドメインを Resend で認証(SPF/DKIM)してから設定する。
# 未設定だと onboarding@resend.dev が使われ、**Resendアカウント所有者にしか届かない**。
# RESEND_FROM=Classmino <noreply@mail.classmino.com>
# 返信先（公開連絡先）。未設定なら FROM 宛に返信される。
# RESEND_REPLY_TO=

# ---- 公開URL ----
# メール本文の絶対リンクと OGP(metadataBase) に使う。
# 未設定なら Vercel の本番URL、それも無ければ localhost にフォールバックする。
# NEXT_PUBLIC_APP_URL=https://classmino.com

# ---- Web Push (VAPID) ----
# npx web-push generate-vapid-keys で生成する。
# 独自ドメインは不要。鍵を変えると既存の購読がすべて無効になるので、一度決めたら変えない。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- cron (Vercel) ----
# Vercel が cron 実行時に `Authorization: Bearer <値>` として送る共有シークレット。
# 設定しないと /api/cron/notify を誰でも叩ける。
CRON_SECRET=

# ---- レートリミット (Upstash Redis / 任意) ----
# 未設定でもアプリは動く（フェイルオープン＝制限なし）。本番では設定推奨。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
